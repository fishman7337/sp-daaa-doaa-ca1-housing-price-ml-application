# Flask
FLASK_APP=app:create_app
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
PORT=5000

# Database
# Local default: leave DATABASE_URL blank to use instance/local_db.db.
DATABASE_URL=
SQLALCHEMY_DATABASE_URI=
SQLITE_DB_NAME=local_db.db

# Runtime paths
MODEL_DIR=models
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH_MB=16

# Market data
TREND_TIMESERIES_PATH=data/usa_real_estate_price_time_series.csv
TREND_HISTOGRAM_PATH=data/usa_real_estate_price_histogram.csv
TREND_DATA_PATH=data/processed/usa_real_estate_clean.csv
TREND_DATA_URL=

# Optional OpenAI-backed housing chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gunicorn tuning for Docker/Render
WEB_CONCURRENCY=1
WEB_TIMEOUT=120
